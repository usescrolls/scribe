{
  "name": "scribe-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@wailsio/runtime": "^3.0.0-alpha.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "oxfmt": "^0.1.0",
    "oxlint": "^0.16.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.0.0"
  }
}
